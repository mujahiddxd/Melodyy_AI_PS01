DATABASE_URL=postgresql+psycopg://hod:hod@localhost:5433/hod
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24
OTP_PROVIDER=mock            # mock | msg91 (twilio is a stub). Only "mock" enables the demo SMS inbox.
OTP_SECRET=change-me-too
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=       # DLT-approved OTP template id from the MSG91 dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
LLM_PROVIDER=gemini          # gemini | openai
LLM_API_KEY=
LLM_API_KEYS=               # extra fallback keys, comma separated: tried in order when LLM_API_KEY fails/is rate limited
LLM_MODEL_TEXT=gemini-3.8-flash
LLM_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite   # tried in order when the primary model is overloaded
LLM_MODEL_VISION=
LLM_MOCK=true                # true = canned outputs, no API calls
STT_PROVIDER=sarvam          # sarvam | whisper
SARVAM_API_KEY=
OPENAI_API_KEY=
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>. Leave empty -> local storage fallback.
CLOUDINARY_URL=
STORE_AUDIO=false
GOOGLE_MAPS_API_KEY=         # Geocoding API enabled + billing on. Backend only, never in the frontend. Empty -> place search returns nothing (map click and GPS still work).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
TZ_NAME=Asia/Kolkata
